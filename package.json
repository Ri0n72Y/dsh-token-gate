{
  "name": "dsh-token-gate",
  "version": "0.3.0",
  "description": "Opaque token-bootstrap gateway for DeepSeek Harness with HttpOnly sessions, IP allowlists, trusted-proxy handling, and reverse proxying",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "gateway",
    "authentication",
    "reverse-proxy"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ri0n72Y/dsh-token-gate.git"
  },
  "homepage": "https://github.com/Ri0n72Y/dsh-token-gate#readme",
  "bugs": {
    "url": "https://github.com/Ri0n72Y/dsh-token-gate/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test \"test/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "tsdown --config tsdown.config.ts",
    "prepack": "pnpm run check",
    "deploy": "pnpm run prepare && dsh plugin --profile web add ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
