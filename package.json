{
  "name": "dsh-token-gate",
  "version": "0.2.0",
  "description": "Sidecar gateway for DeepSeek Harness: token-bootstrap + HttpOnly-session entry gate with 404 disguise, IP allowlist, and reverse proxy to the local dsh web server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "smoke": "node test/smoke.mjs",
    "prepare": "tsdown --config tsdown.config.ts",
    "deploy": "pnpm run prepare && dsh plugin --profile web add ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
